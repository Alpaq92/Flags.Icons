<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>true</IsPackable>

        <PackageId>Flags.Icons.Avalonia</PackageId>
        <Description>Avalonia control that displays flag icons from 5 bundled sources (Twemoji emoji, Circle, Square, Lipis, FlagHub). Avalonia-specific implementation of Flags.Icons.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Update="**\*.xaml.cs">
            <DependentUpon>%(Filename)</DependentUpon>
        </Compile>
        <AvaloniaResource Include="**\*.xaml">
            <SubType>Designer</SubType>
        </AvaloniaResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <!-- Held at 12.0.0.13: 12.0.0.14+ moves Svg.Skia to 5.2.x, which targets SkiaSharp 4.148,
             while Avalonia 12.x still ships SkiaSharp 3.119 (incl. the WebAssembly native assets).
             Mixing them breaks the Browser demo link step (wasm-ld: undefined sk_pathbuilder_* symbols).
             Bump together with Avalonia once it moves to SkiaSharp 4. Mirrored in .github/dependabot.yml. -->
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flags.Icons\Flags.Icons.csproj" />
    </ItemGroup>

</Project>
